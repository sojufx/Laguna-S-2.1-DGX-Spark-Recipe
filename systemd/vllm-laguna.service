[Unit]
Description=vLLM Laguna S 2.1 Production Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME
EnvironmentFile=/home/CHANGE_ME/laguna.env
ExecStart=/home/CHANGE_ME/bin/start-laguna.sh
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=60
StandardOutput=append:/home/CHANGE_ME/vllm-laguna.log
StandardError=append:/home/CHANGE_ME/vllm-laguna.log

[Install]
WantedBy=multi-user.target
